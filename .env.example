# Supabase email collection (see README "Wiring up email collection")
# Server-side only — never expose the service role key to the browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Thank-you email for new signups (see lib/thanks.js). Leave unset to save signups without emailing.
RESEND_API_KEY=your-resend-api-key
# Optional: THANKS_FROM="Cleophis <hello@cleophis.com>"  THANKS_REPLY_TO=hello@cleophis.com
